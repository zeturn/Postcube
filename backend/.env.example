# BasaltPass OAuth settings
BASALTPASS_BASE_URL=http://localhost:8101
BASALTPASS_CLIENT_ID=
BASALTPASS_CLIENT_SECRET=
BASALTPASS_REDIRECT_URI=http://localhost:8113/api/auth/callback

# Frontend URL for redirects and CORS
FRONTEND_URL=http://localhost:5116
ALLOWED_ORIGINS=http://localhost:5116

# Session / JWT
JWT_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=postcube_session
COOKIE_SECURE=false
COOKIE_DOMAIN=

# App DB
DB_PATH=./postcube.db
